# Optional TURN relay. Leave all values unset for STUN-only direct voice.
# Metered: copy all turn: and turns: URLs from the dashboard, comma-separated.
# Copy username to TURN_USERNAME and credential to TURN_PASSWORD.
TURN_URLS=
TURN_USERNAME=
TURN_PASSWORD=
# Alternative: Coturn shared-secret authentication (leave username/password blank).
# TURN_SECRET must match the relay's static-auth-secret; never put it in the UI.
# A complete username/password pair takes precedence over TURN_SECRET.
TURN_SECRET=
